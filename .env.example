ENVIRONMENT=development

# Logfire
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development

# Bhashini API Key
MEITY_API_KEY_VALUE=

# Marqo
MARQO_ENDPOINT_URL=http://localhost:8882/
MARQO_INDEX_NAME=sunbird-va-index

# Redis
REDIS_HOST=redis-stack
REDIS_PORT=6379
REDIS_DB=0

# MinIO object storage for pest uploads. MinIO runs as a separate instance;
# set these values from that instance's environment and lifecycle policy.
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PEST_UPLOAD_BUCKET=pest-detection-uploads

# Mapbox
MAPBOX_API_TOKEN=

# Beckn
BAP_ID=
BAP_URI=
BAP_ENDPOINT=
## BPPs
POCRA_BPP_ID=
POCRA_BPP_URI=
MAHADBT_BPP_ID=
MAHADBT_BPP_URI=
## Bharat Vistaar cross-network
BHARAT_VISTAAR_BPP_ID=bpp-network-playground-sandbox-vistaar.da.gov.in
BHARAT_VISTAAR_BPP_URI=https://bpp-network-playground-sandbox-vistaar.da.gov.in
# Option A: delegate to Bharat Vistaar chat agent (recommended)
BHARAT_VISTAAR_API_URL=
# Auth for cross-network chat API (optional — auto-fetches guest JWT if unset)
BHARAT_VISTAAR_API_TOKEN=
BHARAT_VISTAAR_API_KEY=
BHARAT_VISTAAR_CLIENT_CODE=MahaVistaar
# Option B: Beckn search to Bharat BAP (if no chat API)
BHARAT_VISTAAR_BAP_ENDPOINT=
BHARAT_VISTAAR_BAP_ID=
BHARAT_VISTAAR_BAP_URI=

# Azure OpenAI (fallback model)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# vLLM
LLM_PROVIDER=vllm
LLM_AGRINET_MODEL_NAME=agrinet-model
LLM_MODERATION_MODEL_NAME=moderation-model
VLLM_AGRINET_MODEL_URL=http://localhost:8080/v1
VLLM_MODERATION_MODEL_URL=http://localhost:8081/v1

# vLLM Concurrency Limits (optional, defaults shown)
VLLM_AGRINET_MAX_CONCURRENT=60
VLLM_MODERATION_MAX_CONCURRENT=100
